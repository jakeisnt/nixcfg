#!/bin/sh
# Bootstrap or rebuild nix-darwin without requiring Bun or Homebrew.
set -eu

repo=${DOTFILES_REPO:-https://github.com/jakeisnt/nixcfg.git}
if [ -n "${DOTFILES:-}" ]; then
  flake=$DOTFILES
elif [ -f "$(dirname -- "$0")/../flake.nix" ]; then
  flake=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
else
  flake=${DOTFILES_DIR:-"$HOME/.config/nixcfg"}
fi
target=${DARWIN_TARGET:-mac}
export DARWIN_USER=${DARWIN_USER:-$(id -un)}
repair_nix=false
assume_yes=false

usage() {
  cat <<'EOF'
Usage: darwin-bootstrap [--repair-nix [--yes]]

  --repair-nix  uninstall and reinstall Nix when its nixbld group has the
                wrong GID for nix-darwin
  --yes         confirm a destructive Nix reinstall (required without a TTY)
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repair-nix) repair_nix=true ;;
    --yes) assume_yes=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo "error: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if [ "$(uname -s)" != Darwin ]; then
  echo "error: darwin-bootstrap must run on macOS" >&2
  exit 1
fi
if [ "$(uname -m)" != arm64 ]; then
  echo "error: this configuration currently supports Apple Silicon (arm64) only" >&2
  exit 1
fi
if [ "$(id -u)" -eq 0 ]; then
  echo "error: run this as your normal user; the script invokes sudo when needed" >&2
  exit 1
fi
if [ "$DARWIN_USER" = root ] || [ -z "$DARWIN_USER" ]; then
  echo "error: could not determine a normal macOS username" >&2
  exit 1
fi
if [ ! -f "$flake/flake.nix" ]; then
  if [ -e "$flake" ]; then
    echo "error: $flake exists but is not a Nix flake checkout" >&2
    exit 1
  fi
  echo "Downloading $repo into $flake"
  mkdir -p "$(dirname -- "$flake")"
  archive=$(mktemp "${TMPDIR:-/tmp}/nixcfg.XXXXXX.tar.gz")
  unpacked=$(mktemp -d "${TMPDIR:-/tmp}/nixcfg.XXXXXX")
  trap 'rm -f "$archive"; rm -rf "$unpacked"' EXIT HUP INT TERM
  curl --proto '=https' --tlsv1.2 -fsSL "${repo%.git}/archive/refs/heads/main.tar.gz" \
    -o "$archive"
  tar -xzf "$archive" -C "$unpacked"
  source_dir=$(find "$unpacked" -mindepth 1 -maxdepth 1 -type d -print -quit)
  if [ -z "$source_dir" ] || [ ! -f "$source_dir/flake.nix" ]; then
    echo "error: downloaded archive does not contain a flake" >&2
    exit 1
  fi
  mv "$source_dir" "$flake"
fi

install_nix() {
  echo "Installing Nix with the Determinate Nix Installer."
  curl --proto '=https' --tlsv1.2 -fsSL https://install.determinate.systems/nix | \
    sh -s -- install --no-confirm
  if [ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
    # shellcheck disable=SC1091
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  fi
  if ! command -v nix >/dev/null 2>&1; then
    echo "error: Nix installed, but it is not available in this shell; open a new terminal and retry" >&2
    exit 1
  fi
}

nixbld_gid() {
  dscl . -read /Groups/nixbld PrimaryGroupID 2>/dev/null |
    awk '$1 == "PrimaryGroupID:" { print $2 }'
}

repair_nix_installation() {
  if [ ! -x /nix/nix-installer ]; then
    echo "error: /nix/nix-installer is missing; cannot safely perform the deterministic reinstall" >&2
    echo "Install Nix with the Determinate Nix Installer, then rerun with --repair-nix." >&2
    exit 1
  fi

  if [ "$assume_yes" = false ]; then
    if [ ! -t 0 ] || [ ! -t 1 ]; then
      echo "error: refusing to uninstall Nix without a TTY" >&2
      echo "Rerun with: $0 --repair-nix --yes" >&2
      exit 1
    fi
    printf 'Nix will be uninstalled and reinstalled. Continue? [y/N] '
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *) echo "Nix reinstall cancelled."; exit 1 ;;
    esac
  fi

  echo "Uninstalling Nix to repair the nixbld group ID."
  sudo /nix/nix-installer uninstall --no-confirm
  install_nix

  if [ "$(nixbld_gid)" != 350 ]; then
    echo "error: Nix was reinstalled, but nixbld still has an unexpected GID: $(nixbld_gid)" >&2
    exit 1
  fi
}

if ! command -v nix >/dev/null 2>&1; then
  install_nix
fi

# nix-darwin currently expects the default nixbld group to use GID 350. An
# existing Nix installation can retain the old 30000 GID, which fails during
# activation. Do not silently destroy an installation: opt into the repair.
actual_nixbld_gid=$(nixbld_gid)
if [ -n "$actual_nixbld_gid" ] && [ "$actual_nixbld_gid" != 350 ]; then
  if [ "$repair_nix" = true ]; then
    repair_nix_installation
  else
    echo "error: nixbld has GID $actual_nixbld_gid, but nix-darwin expects GID 350" >&2
    echo "Rerun with: $0 --repair-nix" >&2
    exit 1
  fi
fi

cd "$flake"
if command -v darwin-rebuild >/dev/null 2>&1; then
  exec sudo darwin-rebuild switch --flake "$flake#$target" --option pure-eval no
fi

echo "darwin-rebuild is not installed; evaluating and activating nix-darwin once."
exec sudo nix --extra-experimental-features 'nix-command flakes' run nix-darwin -- \
  switch --flake "$flake#$target" --option pure-eval no
