#!/usr/bin/env python3
"""Prepare and publish a verified lockfile update without changing the checkout."""

import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
from datetime import datetime, timezone


def run(*args, cwd=None, capture=False):
    return subprocess.run(
        args, cwd=cwd, check=True, text=True,
        stdout=subprocess.PIPE if capture else None,
    ).stdout


def notify(message):
    print(message, flush=True)
    try:
        run("notify-send", "NixOS update", message)
    except (OSError, subprocess.CalledProcessError):
        pass  # Notifications are best effort; status is always in the journal.


def update(repo, base, worktree):
    # Keep failed attempts for inspection and require explicit cleanup to retry.
    if worktree.exists():
        raise RuntimeError(
            f"Previous worktree exists: {worktree}. Inspect and remove it with "
            "git worktree remove before retrying."
        )
    run("git", "fetch", "origin", base, cwd=repo)
    revision = run("git", "rev-parse", "FETCH_HEAD", cwd=repo, capture=True).strip()
    branch = "updates/flake-" + datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    run("git", "worktree", "add", "-b", branch, str(worktree), revision, cwd=repo)
    run("nix", "flake", "update", "--flake", ".", "--impure", cwd=worktree)
    changes = run("git", "status", "--porcelain", "--untracked-files=all",
                  cwd=worktree, capture=True)
    if not changes:
        run("git", "worktree", "remove", str(worktree), cwd=repo)
        notify("No flake updates available.")
        return

    run("nix", "flake", "check", "--all-systems", "--no-build", cwd=worktree)
    targets = json.loads(run("nix", "eval", "--json", ".#checks.x86_64-linux",
                             "--apply", "builtins.attrNames", cwd=worktree, capture=True))
    if not isinstance(targets, list) or not targets or not all(
        isinstance(target, str) and target for target in targets
    ):
        raise RuntimeError("No valid Linux checks discovered.")
    for target in targets:
        run("nix", "build", f".#checks.x86_64-linux.{target}", "--no-link",
            "--option", "pure-eval", "no", cwd=worktree)
    run("git", "add", "flake.lock", cwd=worktree)
    run("git", "diff", "--cached", "--check", cwd=worktree)
    run("git", "diff", "--cached", "--stat", cwd=worktree)
    # Include untracked files and changes made by build hooks in this guard.
    changes = run("git", "status", "--porcelain", "--untracked-files=all",
                  cwd=worktree, capture=True)
    if changes != "M  flake.lock\n":
        raise RuntimeError("Unexpected changes in update worktree; refusing to commit.")
    run("git", "-c", "commit.gpgsign=false", "commit", "-m",
        "chore: update flake inputs", cwd=worktree)
    run("git", "push", "--atomic", "origin", f"HEAD:refs/heads/{branch}", cwd=worktree)
    run("git", "worktree", "remove", str(worktree), cwd=repo)
    notify(f"Verified update pushed to {branch}. Review and merge, then run hey rebuild.")


def main():
    repo = Path(sys.argv[1] if len(sys.argv) > 1 else "/etc/nixos").resolve()
    base = sys.argv[2] if len(sys.argv) > 2 else "main"
    state_home = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    state = Path(os.environ.get("STATE_DIRECTORY") or state_home / "flake-update").resolve()
    state.mkdir(parents=True, exist_ok=True)
    os.environ["GIT_TERMINAL_PROMPT"] = "0"
    os.environ["GIT_SSH_COMMAND"] = "ssh -o BatchMode=yes -o ConnectTimeout=30"
    with (state / "lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        try:
            update(repo, base, state / "worktree")
        except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
            notify(f"Update failed: {error}. See journalctl -u flake-update "
                   f"and {state / 'worktree'}.")
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
